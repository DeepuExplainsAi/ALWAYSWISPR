<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. User-installed certificates are NOT trusted, which blocks man-in-the-middle sniffing of the API key. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
